{
  "name": "shithaa-ecommerce",
  "version": "1.0.0",
  "description": "Shithaa - Elegant Maternity & Feeding Wear E-commerce Platform",
  "main": "ecosystem.config.js",
  "scripts": {
    "deploy": "chmod +x deploy.sh && ./deploy.sh deploy",
    "start": "chmod +x start-pm2.sh && ./start-pm2.sh",
    "build": "cd frontend && npm run build && cd ../admin && npm run build",
    "install-all": "cd frontend && npm install && cd ../backend && npm install && cd ../admin && npm install",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop all",
    "pm2:restart": "pm2 restart all",
    "pm2:delete": "pm2 delete all",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs",
    "pm2:monitor": "pm2 monit",
    "start-reconciliation": "node backend/jobs/reconcileDrafts.js",
    "start-reservation-cleanup": "node backend/jobs/cleanupReservations.js"
  },
  "dependencies": {
    "@tailwindcss/line-clamp": "^0.4.4",
    "axios": "^1.10.0",
    "cors": "^2.8.5",
    "express-pino-logger": "^7.0.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.23.0",
    "ioredis": "^5.8.0",
    "lucide-react": "^0.542.0",
    "mongoose": "^8.16.2",
    "pdfkit": "^0.15.0",
    "pino": "^9.1.0",
    "pino-multi-stream": "^6.0.0",
    "pino-pretty": "^11.0.0",
    "pm2": "^5.4.0",
    "pretty-ms": "^9.0.0",
    "react-icons": "^5.5.0",
    "redlock": "^5.0.0-beta.2",
    "rotating-file-stream": "^3.2.7",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.8"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "ecommerce",
    "maternity",
    "nextjs",
    "express",
    "mongodb",
    "pm2"
  ],
  "author": "Shithaa Team",
  "license": "ISC"
}
